    <Using Remove="VerifyNUnit" />
    <Using Remove="VerifyNUnit.Verifier" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evolutionary\Evolutionary.csproj" />
  </ItemGroup>

</Project>
