{
  "metadata": [
    {
      "src": [
        {
          "files": ["Evolutionary.csproj"],
          "src": "../Evolutionary"
        }
      ],
      "dest": "api",
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"],
        "exclude": ["**/obj/**"]
      },
      {
        "files": ["toc.yml", "index.md"]
      }
    ],
    "resource": [
      {
        "files": ["brand/evolutionary-finch.svg", "brand/evolutionary-finch-header.svg", "brand/evolutionary-finch-128.png"],
        "src": "..",
        "dest": "."
      }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Evolutionary",
      "_appName": "Evolutionary",
      "_appLogoPath": "brand/evolutionary-finch-header.svg",
      "_appLogoTitle": "Evolutionary",
      "_gitContribute": {
        "repo": "https://github.com/quinmars/evolutionary",
        "branch": "master"
      }
    }
  }
}
